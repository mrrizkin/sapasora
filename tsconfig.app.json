{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": [
      "auto-imports.d.ts",
      "components.d.ts",
      "env.d.ts",
      "resources/js/**/*.js",
      "resources/js/**/*.ts",
      "resources/js/**/*.vue"
  ],
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "skipLibCheck": true,

    "baseUrl": ".",
    "paths": {
      "@/*": ["./resources/*"],
      "#build/ui": [
        "./node_modules/.nuxt-ui/ui"
      ]
    }
  }
}
