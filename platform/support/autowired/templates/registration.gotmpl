// Package {{ .PackageName }} is autowired dependency injection module,
package {{.PackageName}}

// Code generated by autowired. DO NOT EDIT.
// Generated from {{.SourceCount}} source files

import (
    "go.uber.org/fx"
{{- range $alias, $path := .Imports }}
    {{ $alias }} "{{ $path }}"
{{- end }}
)

{{ if .Comment -}}
// {{.Comment}}
{{- end }}

// AutowiredModule returns fx.Option with all auto-discovered dependencies
var AutowiredModule = fx.Options(
    AutowiredProvidersModule,
    AutowiredDecoratorsModule,
)

// Individual modules for selective inclusion
{{ if .Providers }}
// AutowiredProvidersModule returns only provider functions
var AutowiredProvidersModule = fx.Options(
{{- range .Providers}}
    {{ . }}
{{- end }}
)
{{ end -}}


{{ if .Decorators }}
// AutowiredDecoratorsModule returns only decorator functions
var AutowiredDecoratorsModule = fx.Options(
{{- range .Decorators }}
    {{ . }}
{{- end }}
)
{{ end -}}

{{ if .Invokers }}
// AutowiredInvokersModule returns only invoke functions
var AutowiredInvokersModule = fx.Options(
{{- range .Invokers }}
    {{ . }}
{{- end }}
)
{{ end -}}

{{ if .Groups }}
// Group-specific modules
{{range $group, $items := .Groups}}
// {{$group}}GroupModule returns dependencies for group "{{$group}}"
var {{$group}}GroupModule = fx.Options(
{{- range $items }}
    {{ . }}
{{- end }}
)
{{ end }}
{{ end -}}


// Registry information for debugging
var (
{{- if .ProviderFuncs }}
    // Providers contains all provider functions
    Providers = []any{
    {{- range .ProviderFuncs }}
        {{ . }},
    {{- end }}
    }
{{ end -}}


{{- if .DecoratorFuncs }}
    // Decorators contains all decorator functions
    Decorators = []any{
    {{- range .DecoratorFuncs }}
        {{ . }},
    {{- end }}
    }
{{ end -}}


{{- if .InvokerFuncs }}
    // Invokers contains all invoke functions
    Invokers = []any{
    {{- range .InvokerFuncs }}
        {{ . }},
    {{- end }}
    }
{{ end }}

    // ConstructorInfo provides metadata about each constructor
    ConstructorInfo = map[string]string{
    {{- range .InfoMap }}
        "{{ .Key }}": "{{ .Value }}",
    {{- end }}
    }
)

{{- if .NamedProviders }}

// Named provider functions for dynamic access
{{- range $name, $provider := .NamedProviders }}
// Get{{ $name }} returns the {{ $name }} provider
func Get{{ $name }}() interface{} {
    return {{ $provider }}
}
{{- end }}
{{- end -}}
