package views

import "sapasora/platform/ui/bundler"

templ App() {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title inertia>Sapasora</title>
			<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96"/>
			<link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
			<link rel="shortcut icon" href="/favicon.ico"/>
			<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png"/>
			<meta name="apple-mobile-web-app-title" content="sapasora"/>
			<link rel="preconnect" href="https://fonts.bunny.net"/>
			<link href="https://fonts.bunny.net/css?family=instrument-sans:400,500,600" rel="stylesheet" crossorigin="anonymous"/>
			<link rel="manifest" href="/site.webmanifest"/>
			@templ.Raw(bundler.Vite(ctx).Entry("resources/js/colormode.ts", "resources/js/app.ts"))
			{ `{{ .inertiaHead }}` }
		</head>
		<body class="font-sans antialiased isolate">
			{ `{{ .inertia }}` }
		</body>
	</html>
}
